# Copy this file to .env and fill in the values.

# Password for the /admin dashboard. Only you should know this.
ADMIN_PASSWORD=change-me

# Random secret used to sign the session cookie. Generate with:  openssl rand -hex 32
SECRET_KEY=

# Optional. Defaults to a local SQLite file (instance/drp.sqlite3).
# For Postgres (e.g. Neon/Render): postgresql+psycopg://user:pass@host/db?sslmode=require
# and add `psycopg[binary]` to requirements.txt.
# DATABASE_URL=
